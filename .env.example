# Copy to ~/.config/telegram-exec-notifier/environment, then run ./encrypt-credentials.sh,
# which encrypts it to environment.cred and deletes the plain file. Never commit real values.

# Required
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id

# Optional: Claude runs without asking when its working directory is inside this folder.
# New conversations also start here. Everything else is approved on Telegram.
# TELEGRAM_CLAUDE_AUTO_DIR=/home/you/sandbox

# Optional: seconds to wait for a Telegram answer before denying (default 300)
# TELEGRAM_PERMISSION_TIMEOUT=300

# Optional: seconds before a CLI run is stopped (default 1800)
# TELEGRAM_COMMAND_TIMEOUT=1800

# Optional: local endpoint used by notify-telegram
# TELEGRAM_NOTIFIER_HOST=127.0.0.1
# TELEGRAM_NOTIFIER_PORT=8765
# TELEGRAM_NOTIFIER_URL=http://127.0.0.1:8765
