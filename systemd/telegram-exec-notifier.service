[Unit]
Description=Telegram execution notification forwarder
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=%h/.config/telegram-exec-notifier/environment
Environment=PYTHONPATH=@PROJECT_DIR@/src
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m telegram_exec_notifier.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
