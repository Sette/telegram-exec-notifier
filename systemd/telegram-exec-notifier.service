[Unit]
Description=Telegram execution notification forwarder
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/brunos/git/telegram-exec-notifier
EnvironmentFile=%h/.config/telegram-exec-notifier/environment
Environment=PYTHONPATH=/home/brunos/git/telegram-exec-notifier/src
Environment=PATH=/home/brunos/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m telegram_exec_notifier.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/brunos

[Install]
WantedBy=default.target
